{
  "name": "designforge-studio",
  "version": "0.2.0-alpha.4",
  "private": true,
  "type": "module",
  "description": "Local-first, agent-friendly visual UI design editor",
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "node tools/forge.mjs validate examples/Orbit.project.json",
    "audit": "node tools/forge.mjs audit examples/Orbit.project.json",
    "export": "node tools/forge.mjs export examples/Orbit.project.json ./output",
    "test:browser": "playwright test",
    "examples": "node tools/make-m1-examples.mjs",
    "format:check": "prettier --check src tools tests index.html playwright.config.mjs",
    "format": "prettier --write src tools tests index.html playwright.config.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
